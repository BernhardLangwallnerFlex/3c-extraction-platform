# Copy to .env and fill in real values: cp .env.example .env

# --- Storage ---
STORAGE_BACKEND=local                    # local | azure | s3
LOCAL_STORAGE_BASE_DIR=./temp            # Only used when STORAGE_BACKEND=local

# Azure Blob Storage (only needed when STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_INPUT_PREFIX=az://invoices/uploads/
AZURE_OUTPUT_PREFIX=az://invoices/processed/

# --- Redis / Job Queue ---
REDIS_URL=redis://localhost:6379/0       # docker-compose overrides this
RQ_QUEUE_NAME=invoice-jobs

# --- API Authentication ---
INVOICE_API_KEY=changeme123

# --- Azure OpenAI ---
AZURE_OPENAI_KEY=
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_VISION_MODEL=gpt-5.4

# --- OCR: Mistral ---
MISTRAL_API_KEY=

# --- OCR: Azure Document Intelligence ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
